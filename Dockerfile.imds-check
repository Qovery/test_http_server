FROM public.ecr.aws/docker/library/alpine:3.20
RUN apk add --no-cache curl iproute2 >/dev/null; \
    echo "imds-check: run 7 rootful, engine a14e5e5 (MR 3135 at 6579089f8 merged with main)"; echo "imds-check: hostname $(hostname)"; \
    ip -4 -o addr | awk '{print "imds-check: iface", $2, $4}'; \
    ip route | sed 's/^/imds-check: route /'; \
    c=$(curl -s -o /dev/null -w '%{http_code}' -m 3 -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' || true); \
    echo "imds-check: AWS IMDS token PUT ${c:-000}"; \
    g=$(curl -s -o /dev/null -w '%{http_code}' -m 3 -H 'Metadata-Flavor: Google' http://169.254.169.254/computeMetadata/v1/instance/id || true); \
    echo "imds-check: GCE metadata ${g:-000}"; \
    s=$(curl -s -o /dev/null -w '%{http_code}' -m 3 http://169.254.42.42/conf || true); \
    echo "imds-check: SCW metadata ${s:-000}"
CMD ["sleep", "3600"]
